# Copy this file to .env.local and fill in your own values there.
# Never put real values in this file, in a prompt or in chat.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# AI draft (optional). Keep the real key in .env.local and Vercel settings only.
ANTHROPIC_API_KEY=
# Team passcode for AI drafts (not a real password)
AGENT_PASSCODE=
# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_DAILY_LIMIT=30
# Player photos (optional). Keep the real key in .env.local and Vercel settings only.
API_FOOTBALL_KEY=
